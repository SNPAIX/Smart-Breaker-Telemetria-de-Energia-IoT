# Copiar a ".env" en la raíz del repo y llenar valores reales antes de
# `docker compose up` (el docker-compose.yml de la raíz, no el de
# backend-server/). ".env" nunca se sube al repo.
#
# Todo local: no hay ningún paso de build que publique nada a un registry
# ni a un proveedor cloud. Para mover esta plataforma a otra máquina, se
# copia el repo entero (zip o `git clone`) y se corre este mismo
# `docker compose build` ahí — ver docs/despliegue.md.

# --- Postgres ---
POSTGRES_USER=voltguard_user
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-real
POSTGRES_DB=voltguard_db

# --- Backend ---
# Genera una real con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-generada-aleatoriamente

# --- Asistente de voz (etapa 14, opcional) ---
# En false, la imagen del backend ni siquiera compila IA-Assistant/.
ENABLE_VOICE_ASSISTANT=false
VOICE_ASSISTANT_ENABLED=false
VOICE_ASSISTANT_MODEL_PATH=
