# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube al repo (ya está en .gitignore).

# Clave usada para firmar los JWT de autenticación. Genera una real con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-generada-aleatoriamente

# Cadena de conexión a Postgres. El valor de aquí abajo coincide con las
# credenciales por defecto de docker-compose.yml para desarrollo local.
DATABASE_URL=postgresql://voltguard_user:supersecretpassword@localhost:5432/voltguard_db

# "development" o "production" — controla nivel de logging y validaciones.
ENVIRONMENT=development

# Minutos de vigencia del JWT de usuario. Default: 10080 (7 dias).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Nivel de log: DEBUG, INFO, WARNING, ERROR. Default: INFO.
LOG_LEVEL=INFO

# Estrategia del detector de anomalías: "rule_based" (sin IA) o
# "isolation_forest" (con IA). Default: rule_based.
ANOMALY_DETECTOR=rule_based

# Segundos sin telemetria/heartbeat antes de considerar un dispositivo
# offline (etapa 7, dashboard admin). Default: 300 (5 minutos).
DEVICE_ONLINE_THRESHOLD_SECONDS=300

# Asistente de voz (etapa 14, modulo aislado en IA-Assistant/). Apagado
# por defecto: en false, el backend ni siquiera intenta importar
# ia_assistant. Para activarlo tambien hay que construir la imagen con
# ENABLE_VOICE_ASSISTANT=true (ver docker-compose.yml) o instalar el
# paquete localmente (ver IA-Assistant/README.md).
VOICE_ASSISTANT_ENABLED=false

# Ruta absoluta a un modelo .gguf para el fallback de LLM del asistente de
# voz. Opcional: si se deja vacio, el asistente sigue funcionando solo con
# el matcher deterministico.
VOICE_ASSISTANT_MODEL_PATH=
